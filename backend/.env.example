# Pega aquí tu clave de API de Gemini (Google AI Studio)
# Puedes obtenerla gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_aqui_sin_comillas

# Opcional: autentica las rutas administrativas y el puente macro.
# Usa el mismo valor en el campo "Token local del backend" del dashboard.
# Otros clientes locales deben enviarlo en el encabezado X-API-Token.
APP_SECRET_TOKEN=reemplazar_por_un_token_aleatorio
